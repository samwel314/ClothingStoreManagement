@page "/shift-decision"
@inject NavigationManager Nav
@inject AppState AppState
@inject ShiftService ShiftService
@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show border-0 small rounded-3 mb-3 d-flex align-items-center" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-3"></i>

        <div class="flex-grow-1">
            &nbsp;@errorMessage
        </div>
    </div>
}
<div class=" d-flex align-items-center justify-content-center bg-light px-3" dir="rtl">
   
    <div class="col-12 col-lg-8 col-xl-7">

        @if (ActiveShift == null)
        {
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body text-center py-5">

                    <div class="spinner-border text-secondary mb-3"></div>

                    <p class="text-muted mb-0">
                        جارِ تحميل بيانات الوردية...
                    </p>

                </div>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

                <!-- Header -->
                <div class="bg-white border-bottom p-4">

                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">

                        <div>
                            <h3 class="fw-bold mb-1 text-dark">
                                استكمال الوردية
                            </h3>

                            <p class="text-muted mb-0 small">
                                يوجد شيفت مفتوح حالياً على النظام
                            </p>
                        </div>

                        <div class="bg-light rounded-circle d-flex align-items-center justify-content-center"
                             style="width:70px;height:70px;">

                            <i class="bi bi-clock-history fs-3 text-secondary"></i>

                        </div>

                    </div>

                </div>

                <div class="card-body p-4">

                    <div class="row g-3 mb-4">


                        <div class="col-md-4">

                            <div class="border rounded-4 p-3 h-100 bg-light-subtle">

                                <div class="text-muted small mb-2">
                                    المسؤول
                                </div>

                                <div class="fw-bold fs-5">
                                    @ActiveShift.OpenBy
                                </div>

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="border rounded-4 p-3 h-100 bg-light-subtle">

                                <div class="text-muted small mb-2">
                                    النقدية المتوقعة
                                </div>

                                <div class="fw-bold fs-4">
                                    @ActiveShift.ExpectedCash.ToString("N0")
                                    <span class="fs-6 text-muted">
                                        EGP
                                    </span>
                                </div>

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="border rounded-4 p-3 h-100 bg-light-subtle">

                                <div class="text-muted small mb-2">
                                    وقت البداية
                                </div>

                                <div class="fw-semibold">
                                    @ActiveShift.StartTime.ToString("yyyy/MM/dd")
                                </div>

                                <div class="text-muted small mt-1">
                                    @ActiveShift.StartTime.ToString("hh:mm tt")
                                </div>

                            </div>

                        </div>

                    </div>



<div class="d-flex flex-column flex-md-row gap-3 align-items-stretch bg-light p-3 rounded-3 border mb-3">

    <div class="flex-grow-1 d-flex flex-column justify-content-center text-end">

        <label class="form-label fw-bold text-dark mb-2 fs-6">
            <i class="bi bi-cash-coin text-success me-1"></i>
            إجمالي المبلغ الفعلي الموجود في الدرج حالياً:
        </label>

        <div class="input-group shadow-sm border border-secondary rounded-3 overflow-hidden"
             style="height:85px;">

            <InputNumber @bind-Value="ActiveShift.AcualCash"
                         class="form-control fw-bold text-center text-primary bg-white border-0"
                         style="font-size:2rem;"
                         placeholder="0.00" />

            <span class="input-group-text bg-dark text-white fw-bold px-4 border-0"
                  style="font-size:1.5rem;">
                ج.م
            </span>

        </div>

    </div>

    <div class="flex-grow-1 p-3 bg-warning bg-opacity-10 rounded-3 border border-warning d-flex gap-2 align-items-start">

        <i class="bi bi-exclamation-triangle-fill text-warning fs-3 mt-1"></i>

        <div>
            <h6 class="fw-bold text-warning-dark mb-1 fs-6">
                تنبيه هام جداً للموظف المستلم:
            </h6>

            <p class="text-dark m-0 small lh-base">
                بمجرد إغلاق هذه الوردية،
                <b>سيتم ترحيل كامل المبلغ كاملاً إلى الخزينة الرئيسية فوراً</b>.
                لا يمكنك ترك جزء من هذا المبلغ في الدرج لبدء الوردية الجديدة.
            </p>
        </div>

    </div>

</div>                    
                    
                    <div class="d-flex flex-column flex-md-row gap-2">

                        <button @onclick="HandleContinue"
                                class="btn btn-dark rounded-3 px-4 py-3 flex-fill fw-semibold">

                            <i class="bi bi-arrow-left-circle ms-1"></i>
                            متابعة العمل
                        </button>

                        <button @onclick="HandleStartNew"
                                class="btn btn-outline-secondary rounded-3 px-4 py-3 flex-fill fw-semibold">

                            <i class="bi bi-arrow-repeat ms-1"></i>
                            وردية جديدة
                        </button>

                    </div>

                </div>

            </div>
        }

    </div>

</div>
@code {
    public ShiftDTO? ActiveShift { get; set; }
    string ?errorMessage ; 
    protected override async Task OnInitializedAsync()
    {
        var result = await ShiftService.GetOpenShiftAsync();

        if (result.IsSuccess)
        {
            ActiveShift = result.Data;  
        }
        else
        {
            Nav.NavigateTo("/open-shift");
        }
    }
    private void HandleContinue()
    {
        AppState.SetCurrentShift(ActiveShift!);
        Nav.NavigateTo("/pos");
    }
    private async Task ShowError(string ErrorMessage)
    {
        errorMessage = ErrorMessage;
        await Task.Delay(3000);
        errorMessage = null!;
    }
    private async Task HandleStartNew()
    {
        if (ActiveShift.AcualCash < 0)
        {
          await ShowError ("ادخل رقم صحيح ") ; 
            return;
        }

         await ShiftService.CloseShift(ActiveShift!.Id , ActiveShift.AcualCash);
        Nav.NavigateTo($"/open-shift");
    }

}