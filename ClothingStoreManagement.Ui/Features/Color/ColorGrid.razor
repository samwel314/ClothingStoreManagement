@inject AppState AppState

<div class="card shadow-sm border-0 mt-3" dir="rtl">
    <div class="card-body p-0">
        <table class="table table-striped table-hover align-middle mb-0">

            <thead style="background-color: #0d6efd; color: white;">
                <tr>
                    <th class="py-3 ps-4" style="width: 35%;">
                        اسم اللون
                    </th>

                    <th class="py-3 text-center" style="width: 20%;">
                        الكود
                    </th>

                    <th class="py-3 text-center" style="width: 25%;">
                        المعاينة
                    </th>

                    @if (AppState.CurrentUser?.Role == UserRole.Admin)
                    {
                        <th class="py-3 text-center pe-4" style="width: 20%;">
                            الإجراءات
                        </th>
                    }
                </tr>
            </thead>

            <tbody>
                @if (Colors != null && Colors.Any())
                {
                    @foreach (var color in Colors)
                    {
                        <tr>
                            <!-- Name -->
                            <td class="ps-4">
                                <span class="fw-bold">
                                    @color.Name
                                </span>
                            </td>

                            <!-- Code -->
                            <td class="text-center">
                                <span class="badge bg-light text-dark border font-monospace px-3 py-2">
                                    @color.Code
                                </span>
                            </td>

                            <!-- Preview -->
                            <td class="text-center">
                                <div class="d-inline-flex align-items-center gap-2">

                                    <div class="border shadow-sm"
                                         style="
                                             width: 28px;
                                             height: 28px;
                                             background-color: @color.HexCode;
                                             border-radius: 6px;">
                                    </div>

                                    <small class="text-muted font-monospace">
                                        @color.HexCode
                                    </small>

                                </div>
                            </td>

                            <!-- Actions -->
                            @if (AppState.CurrentUser?.Role == UserRole.Admin)
                            {
                                <td class="text-center pe-4">
                                    <button class="btn btn-outline-primary btn-sm border-0"
                                            title="تعديل"
                                            @onclick="() => OnEdit.InvokeAsync(color)">
                                        <i class="bi bi-pencil-square fs-5"></i>
                                    </button>
                                </td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4"
                            class="text-center py-5 text-muted small">
                            لا توجد بيانات لعرضها حالياً
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public IEnumerable<ColorListDTO> Colors { get; set; } = [];

    [Parameter, EditorRequired]
    public EventCallback<ColorListDTO> OnEdit { get; set; }
}