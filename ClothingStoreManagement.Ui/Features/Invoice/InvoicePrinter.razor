@using ClothingStoreManagement.Application.DTO
@inject IReceiptPrinterService ReceiptPrinterService
@inject NavigationManager Nav

@if (InvoiceModel != null)
{
    <div class="print-container">

        <button class="btn btn-success no-print w-100 mb-2"
                @onclick="HandlePrint">
            طباعة الفاتورة
        </button>

        <div class="ticket">

            <div class="header">
                <h2 class="store-name">متجر الملابس</h2>

                <div class="store-info">
                    <p>العنوان: أسيوط - شارع الجمهورية</p>
                    <p>تليفون المحل: 01000000000</p>
                </div>

                <div class="divider"></div>

                <div class="invoice-meta">
                    <p>رقم: @InvoiceModel.SerialNumber</p>
                    <p>التاريخ: @InvoiceModel.LastUpdate.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
            </div>

            <div class="divider"></div>

            <table class="items-table">
                <thead>
                    <tr>
                        <th>الصنف</th>
                        <th class="text-center">كمية</th>
                        <th class="text-end">إجمالي</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in InvoiceModel.Items)
                    {
                        <tr>
                            <td>
                                <div class="item-name">
                                    @item.ProductName
                                </div>

                                <div class="item-details">
                                    @item.Size | @item.Color
                                </div>

                                @if (item.Discount > 0)
                                {
                                    <div class="item-discount">
                                        خصم @(item.Discount)%
                                    </div>
                                }
                            </td>

                            <td class="text-center">
                                @item.Quantity
                            </td>

                            <td class="text-end">
                                @item.Total.ToString("N2")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="divider"></div>

            <div class="summary">

                <div class="summary-row">
                    <span>الإجمالي:</span>
                    <span>
                        @InvoiceModel.TotalAmount.ToString("N2")
                    </span>
                </div>

                @if (InvoiceModel.TotalAmount > InvoiceModel.TotalAmountWithDiscount)
                {
                    <div class="summary-row discount">
                        <span>إجمالي الخصومات:</span>

                        <span>
                            -@(
                                (InvoiceModel.TotalAmount -
                                InvoiceModel.TotalAmountWithDiscount)
                                .ToString("N2")
                            )
                        </span>
                    </div>
                }

                <div class="summary-row grand-total">
                    <span>الصافي النهائي:</span>

                    <span>
                        @InvoiceModel.TotalAmountWithDiscount.ToString("N2")
                    </span>
                </div>

            </div>

            <div class="divider"></div>

            <div class="footer">
                <p>شكراً لزيارتكم</p>
                <p>الاسترجاع خلال 14 يوم</p>

                <p class="brand-mini">
                    Smart POS | Eng. Samuel Marzouk - 01005415303
                </p>
            </div>

        </div>
    </div>
}

@code {

    [Parameter]
    public InvoiceDTO InvoiceModel { get; set; } = default!;

    private bool _printStarted;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _printStarted || InvoiceModel == null)
            return;

        _printStarted = true;

        await HandlePrint();
    }

    private async Task HandlePrint()
    {
        var success =
            await ReceiptPrinterService.PrintAsync(InvoiceModel);

        if (success)
        {
            Nav.NavigateTo("/pos");
        }
    }
}

<style>

    body {
        font-family: 'Cairo', sans-serif;
    }

    .ticket {
        width: 72mm;
        background: white;
        padding: 4mm;
        margin: 15px auto;
        direction: rtl;
        color: #000;
        line-height: 1.3;

        border: 1px solid #ddd;
        border-radius: 4px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .header {
        text-align: center;
    }

    .store-name {
        margin: 0;
        font-size: 17px;
        font-weight: 700;
    }

    .store-info {
        font-size: 10px;
        margin-top: 1mm;
    }

    .store-info p {
        margin: 0;
    }

    .invoice-meta {
        font-size: 10px;
        font-weight: 600;
    }

    .invoice-meta p {
        margin: 0;
    }

    .divider {
        border-top: 1px solid #000;
        margin: 2mm 0;
    }

    .items-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 10px;
    }

    .items-table th {
        border-bottom: 1px solid #000;
        padding: 1mm 0;
        font-weight: 700;
        text-align: right;
    }

    .items-table td {
        padding: 1mm 0;
        vertical-align: top;
    }

    .item-name {
        font-weight: 700;
    }

    .item-details {
        font-size: 9px;
        color: #000;
    }

    .item-discount {
        font-size: 9px;
        font-weight: 600;
    }

    .summary {
        font-size: 11px;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        margin: 1mm 0;
    }

    .discount {
        font-weight: 600;
    }

    .grand-total {
        font-weight: 700;
        font-size: 14px;
        border-top: 1px solid #000;
        margin-top: 2mm;
        padding-top: 2mm;
    }

    .footer {
        text-align: center;
        font-size: 9px;
        margin-top: 3mm;
    }

    .footer p {
        margin: 1mm 0;
    }

    .brand-mini {
        font-size: 7px;
        margin-top: 2mm;
        text-align: center;
    }

    @@media print {

        @@page {
            size: 80mm auto;
            margin: 0;
        }

        html,
        body {
            width: 80mm !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        body * {
            visibility: hidden;
        }

        .ticket,
        .ticket * {
            visibility: visible;
        }

        .ticket {
            position: fixed;
            top: 0;
            left: 0;
            width: 80mm !important;
            margin: 0 !important;
            padding: 3mm !important;
            box-sizing: border-box !important;
            color: #000 !important;
            background: #fff !important;
        }

        .no-print {
            display: none !important;
        }

        .item-discount,
        .discount,
        .brand-mini,
        .item-details {
            color: #000 !important;
        }

        .ticket,
        .items-table,
        .summary,
        .footer {
            break-inside: avoid;
            page-break-inside: avoid;
        }

        tr {
            break-inside: avoid;
            page-break-inside: avoid;
        }
    }

</style>