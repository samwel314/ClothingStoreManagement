@page "/login"
@inject UserService UserService
@inject AppState AppState
@inject NavigationManager Nav
@inject ShiftService ShiftService

<div class="login-page">

    <div class="login-container">

        <!-- Brand -->
        <div class="brand-section">

            <div class="brand-icon">
                <i class="bi bi-shop-window"></i>
            </div>

            <div class="brand-name">
                Clothing<span>POS</span>
            </div>

            <div class="brand-subtitle">
                نظام إدارة المبيعات والمخزون
            </div>

        </div>

        <!-- Login Card -->
        <div class="login-card">

            <div class="login-title">
                <h4>تسجيل الدخول</h4>
                <p>أدخل بيانات حسابك للمتابعة</p>
            </div>

            <EditForm Model="loginModel" OnValidSubmit="HandleLogin">

                <DataAnnotationsValidator />

                <!-- Username -->
                <div class="form-group">

                    <label>
                        اسم المستخدم
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-person"></i>

                        <InputText @bind-Value="loginModel.UserName"
                                   placeholder="أدخل اسم المستخدم"
                                   autocomplete="username" />

                    </div>

                    <ValidationMessage For="@(() => loginModel.UserName)"
                                       class="validation-message" />

                </div>

                <!-- Password -->
                <div class="form-group">

                    <label>
                        كلمة المرور
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-lock"></i>

                        <InputText type="password"
                                   @bind-Value="loginModel.Password"
                                   placeholder="أدخل كلمة المرور"
                                   autocomplete="current-password" />

                    </div>

                    <ValidationMessage For="@(() => loginModel.Password)"
                                       class="validation-message" />

                </div>

                <!-- Error -->
                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="error-message">

                        <i class="bi bi-exclamation-circle-fill"></i>

                        <span>@error</span>

                    </div>
                }

                <!-- Login -->
                <button type="submit"
                        class="login-button"
                        disabled="@isProcessing">

                    @if (isProcessing)
                    {
                        <span class="spinner-border spinner-border-sm"
                              role="status"
                              aria-hidden="true">
                        </span>

                        <span>جاري تسجيل الدخول...</span>
                    }
                    else
                    {
                        <span>تسجيل الدخول</span>

                        <i class="bi bi-arrow-left"></i>
                    }

                </button>

            </EditForm>

        </div>

        <!-- Footer -->
        <div class="login-footer">

            <div>
                Clothing POS
                <span>•</span>
                @DateTime.Now.Year
            </div>

            <div class="developer">
                Developed by
                <strong>Eng. Samuel Marzouk</strong>

                <a href="https://wa.me/201005415303"
                   target="_blank"
                   title="WhatsApp">

                    <i class="bi bi-whatsapp"></i>

                </a>
            </div>

        </div>

    </div>

</div>

<style>

    /* =========================
       Page
    ========================= */

    .login-page {
        position: fixed;
        inset: 0;

        background:
            radial-gradient(
                circle at 10% 10%,
                rgba(13, 110, 253, 0.08),
                transparent 30%
            ),
            radial-gradient(
                circle at 90% 90%,
                rgba(13, 110, 253, 0.06),
                transparent 30%
            ),
            #f5f7fb;

        display: flex;
        align-items: center;
        justify-content: center;

        direction: rtl;

        font-family:
            "Segoe UI",
            Tahoma,
            Geneva,
            Verdana,
            sans-serif;

        overflow-y: auto;
        padding: 30px 20px;
    }


    /* =========================
       Container
    ========================= */

    .login-container {
        width: 100%;
        max-width: 400px;

        display: flex;
        flex-direction: column;
        align-items: center;
    }


    /* =========================
       Brand
    ========================= */

    .brand-section {
        text-align: center;
        margin-bottom: 22px;
    }

    .brand-icon {

        width: 58px;
        height: 58px;

        margin: 0 auto 12px;

        border-radius: 14px;

        background: #0d6efd;

        color: white;

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 25px;

        box-shadow:
            0 8px 20px rgba(13, 110, 253, 0.22);
    }

    .brand-name {

        font-size: 24px;
        font-weight: 700;

        color: #172033;

        letter-spacing: -0.5px;
    }

    .brand-name span {
        color: #0d6efd;
    }

    .brand-subtitle {

        margin-top: 4px;

        color: #7b8494;

        font-size: 13px;
    }


    /* =========================
       Card
    ========================= */

    .login-card {

        width: 100%;

        background: #ffffff;

        border: 1px solid #e8ebf0;

        border-radius: 16px;

        padding: 30px;

        box-shadow:
            0 12px 35px rgba(31, 41, 55, 0.07);
    }


    /* =========================
       Title
    ========================= */

    .login-title {
        margin-bottom: 26px;
    }

    .login-title h4 {

        margin: 0;

        color: #172033;

        font-size: 20px;
        font-weight: 700;
    }

    .login-title p {

        margin: 6px 0 0;

        color: #8a93a2;

        font-size: 13px;
    }


    /* =========================
       Form
    ========================= */

    .form-group {
        margin-bottom: 18px;
    }

    .form-group label {

        display: block;

        margin-bottom: 7px;

        color: #374151;

        font-size: 13px;
        font-weight: 600;

        text-align: right;
    }


    /* =========================
       Input
    ========================= */

    .input-wrapper {

        height: 46px;

        display: flex;
        align-items: center;

        background: #ffffff;

        border: 1px solid #dfe3e8;

        border-radius: 9px;

        padding: 0 13px;

        transition:
            border-color 0.2s ease,
            box-shadow 0.2s ease;
    }

    .input-wrapper i {

        color: #9aa3b2;

        font-size: 17px;

        margin-left: 10px;

        transition: color 0.2s ease;
    }

    .input-wrapper input {

        width: 100%;

        height: 100%;

        border: none;

        outline: none;

        background: transparent;

        color: #1f2937;

        font-size: 14px;

        text-align: right;
    }

    .input-wrapper input::placeholder {
        color: #a8afbb;
    }

    .input-wrapper:focus-within {

        border-color: #0d6efd;

        box-shadow:
            0 0 0 3px rgba(13, 110, 253, 0.10);
    }

    .input-wrapper:focus-within i {
        color: #0d6efd;
    }


    /* =========================
       Validation
    ========================= */

    .validation-message {

        display: block;

        margin-top: 5px;

        padding-right: 3px;

        color: #dc3545;

        font-size: 12px;
    }


    /* =========================
       Error
    ========================= */

    .error-message {

        display: flex;

        align-items: center;

        gap: 8px;

        margin: 5px 0 18px;

        padding: 10px 12px;

        border-radius: 8px;

        background: #fff5f5;

        border: 1px solid #ffd6d6;

        color: #c62828;

        font-size: 13px;

        text-align: right;
    }

    .error-message i {
        font-size: 15px;
        flex-shrink: 0;
    }


    /* =========================
       Login Button
    ========================= */

    .login-button {

        width: 100%;

        height: 46px;

        border: none;

        border-radius: 9px;

        background: #0d6efd;

        color: #ffffff;

        font-size: 14px;

        font-weight: 600;

        display: flex;

        align-items: center;

        justify-content: center;

        gap: 9px;

        cursor: pointer;

        transition:
            background 0.2s ease,
            box-shadow 0.2s ease,
            transform 0.15s ease;
    }

    .login-button:hover:not(:disabled) {

        background: #0b5ed7;

        box-shadow:
            0 5px 14px rgba(13, 110, 253, 0.22);

        transform: translateY(-1px);
    }

    .login-button:active:not(:disabled) {
        transform: translateY(0);
    }

    .login-button:disabled {

        background: #9aa4b2;

        cursor: not-allowed;

        box-shadow: none;
    }


    /* =========================
       Footer
    ========================= */

    .login-footer {

        width: 100%;

        margin-top: 20px;

        text-align: center;

        color: #9aa3b2;

        font-size: 11px;

        line-height: 1.8;
    }

    .login-footer span {
        margin: 0 4px;
    }

    .developer {
        margin-top: 2px;
    }

    .developer strong {
        color: #667085;
        font-weight: 600;
    }

    .developer a {

        color: #22a447;

        text-decoration: none;

        margin-right: 5px;

        font-size: 13px;

        transition: color 0.2s ease;
    }

    .developer a:hover {
        color: #168638;
    }


    /* =========================
       Mobile
    ========================= */

    @@media (max-width: 480px) {

        .login-page {
            padding: 20px 15px;
        }

        .login-card {
            padding: 25px 20px;
            border-radius: 14px;
        }

        .brand-icon {
            width: 52px;
            height: 52px;
            font-size: 22px;
        }

        .brand-name {
            font-size: 22px;
        }

    }

</style>

@code {

    private LoginRequestDto loginModel = new();

    private string? error;

    private bool isProcessing = false;


    private async Task HandleLogin()
    {
        isProcessing = true;
        error = null;

        var result = await UserService.LoginAsync(loginModel);

        if (result.IsSuccess)
        {
            AppState.Login(result.Data!);

            var shiftResult = await ShiftService.GetOpenShiftAsync();

            if (shiftResult.IsSuccess)
            {
                Nav.NavigateTo("/shift-decision");
            }
            else
            {
                Nav.NavigateTo("/open-shift");
            }
        }
        else
        {
            error = result.ErrorMessage;
        }

        isProcessing = false;
    }

}