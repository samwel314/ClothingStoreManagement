@page "/employees/manage/{Id:int}"
<div class="container-fluid py-4" dir="rtl">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">الملف المالي للموظف: <span class="text-primary">مينا مرزوق</span></h3>
            <p class="text-muted small mb-0">موظف مبيعات / صالة (المرتب الأساسي: 6,200.00 ج.م)</p>
        </div>
        <a href="/employees" class="btn btn-outline-secondary fw-bold px-4 shadow-sm">
            <i class="bi bi-arrow-right me-1"></i> العودة
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-3 mb-4">
        <div class="card-body bg-light py-3">
            <div class="row g-3 align-items-center justify-content-between">
                <div class="col-md-6">
                    <span class="fw-bold text-secondary"><i class="bi bi-calendar3 me-1"></i> اختر شهر المحاسبة لعرض الكروت والتقرير:</span>
                </div>
                <div class="col-md-4">
                    <div class="input-group">
                        <input type="month" class="form-control" />
                        <button class="btn btn-primary fw-bold px-4">تصفية</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col">
            <div class="card shadow-sm border-0 rounded-3 bg-white border-start border-primary border-4 p-3">
                <div class="text-muted small fw-bold">المرتب الأساسي</div>
                <div class="fs-4 fw-bold text-dark mt-1">6,200.00 <span class="small fs-6">ج.م</span></div>
            </div>
        </div>
        <div class="col">
            <div class="card shadow-sm border-0 rounded-3 bg-white border-start border-success border-4 p-3">
                <div class="text-success small fw-bold">➕ المكافآت والحوافز</div>
                <div class="fs-4 fw-bold text-success mt-1">+ 300.00 <span class="small fs-6">ج.م</span></div>
            </div>
        </div>
        <div class="col">
            <div class="card shadow-sm border-0 rounded-3 bg-white border-start border-warning border-4 p-3">
                <div class="small fw-bold" style="color: #8b4513;">🟤 السلف (من الدرج)</div>
                <div class="fs-4 fw-bold mt-1" style="color: #8b4513;">- 400.00 <span class="small fs-6">ج.م</span></div>
            </div>
        </div>
        <div class="col">
            <div class="card shadow-sm border-0 rounded-3 bg-white border-start border-danger border-4 p-3">
                <div class="text-danger small fw-bold">⚠️ الجزاءات المالية</div>
                <div class="fs-4 fw-bold text-danger mt-1">- 150.00 <span class="small fs-6">ج.m</span></div>
            </div>
        </div>
        <div class="col">
            <div class="card shadow-sm border-0 rounded-3 bg-white border-start border-secondary border-4 p-3">
                <div class="text-secondary small fw-bold">❌ خصم الغياب (1 يوم)</div>
                <div class="fs-4 fw-bold text-danger mt-1">- 206.60 <span class="small fs-6">ج.م</span></div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-5">
            <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-header bg-dark text-white fw-bold py-3">
                    <i class="bi bi-plus-circle me-1"></i> تسجيل إجراء جديد
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">نوع العملية</label>
                        <select class="form-select">
                            <option value="penalty">⚠️ جزاء مالي (خصم نقدي مباشر)</option>
                            <option value="absence">❌ تسجيل أيام غياب</option>
                            <option value="bonus">⭐ تسجيل مكافأة / حافز</option>
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">عدد الأيام</label>
                            <input type="number" class="form-control" placeholder="0" min="1" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">المبلغ (ج.م)</label>
                            <input type="number" class="form-control" placeholder="0.00" min="0" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">السبب / البيان</label>
                        <input type="text" class="form-control" placeholder="اكتب تفاصيل الحركة هنا..." />
                    </div>
                    <button class="btn btn-danger w-100 fw-bold py-2">
                        <i class="bi bi-check-lg me-1"></i> تنفيذ وحفظ الإجراء
                    </button>
                </div>
            </div>
        </div>




            <div class="col-md-7">
    
    <div class="card shadow-sm border-0 rounded-3 h-100 bg-success bg-opacity-10 border border-success border-opacity-25 d-flex flex-column justify-content-center p-4 text-center">
        <div class="text-success fw-bold fs-5 mb-2">
            <i class="bi bi-cash-coin me-1"></i> صافي المرتب المستحق للصرف حالياً بعد المقاصة:
        </div>
        <div class="display-4 fw-bold text-success mb-4">5,743.40 <span class="fs-3">ج.م</span></div>
        
        <button class="btn btn-success btn-lg py-3 fw-bold rounded-3 shadow w-100">
            <i class="bi bi-currency-exchange me-1"></i> تأكيد صرف مرتب الموظف نقداً وخصمه من الدرج
        </button>
    </div>
