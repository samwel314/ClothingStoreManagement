</div>  


</div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-secondary text-white fw-bold py-3">
            <i class="bi bi-clock-history me-1"></i> سجل الحركات التفصيلي للموظف خلال الشهر
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-center">
                    <thead class="table-light text-secondary small fw-bold">
                        <tr>
                            <th class="py-3">التاريخ / الوقت</th>
                            <th class="py-3">نوع الحركة</th>
                            <th class="py-3">القيمة / التأثير</th>
                            <th class="py-3">البيان والسبب</th>
                            <th class="py-3">بواسطة</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        <tr>
                            <td class="text-muted">2026/05/10 04:30 م</td>
                            <td><span class="badge px-3 py-2 rounded-pill" style="background-color: #fdf5e6; color: #8b4513; border: 1px solid #f5deb3;">سلفة من الدرج</span></td>
                            <td class="fw-bold">- 400.00 ج.م</td>
                            <td class="text-secondary">سحب سلفة طارئة من شفت المساء</td>
                            <td class="fw-semibold">كاشير الشفت</td>
                        </tr>
                        <tr>
                            <td class="text-muted">2026/05/14 11:00 ص</td>
                            <td><span class="badge px-3 py-2 rounded-pill" style="background-color: #fff5f5; color: #dc3545; border: 1px solid #f8d7da;">جزاء مالي</span></td>
                            <td class="fw-bold text-danger">- 150.00 ج.م</td>
                            <td class="text-secondary">تأخير ساعة كاملة عن فتح المحل</td>
                            <td class="fw-semibold">المدير العام</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>


@code 
{

    [Parameter]
    public int Id { get;set;  }
