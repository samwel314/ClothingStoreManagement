@page "/employees"
@inject EmployeeService EmployeeService

@if (ShowEditModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);" dir="rtl">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold">تعديل بيانات الموظف: @EmployeeToEdit.Name</h5>
                </div>
                <EditForm Model="@EmployeeToEdit" OnValidSubmit="HandleEditSubmit">
                    <DataAnnotationsValidator />
                    <div class="modal-body p-4 text-end">
                        <div class="mb-3">
                            <label class="form-label fw-bold">اسم الموظف</label>
                            <InputText class="form-control" @bind-Value="EmployeeToEdit.Name" />
                            <ValidationMessage For="@(() => EmployeeToEdit.Name)" class="text-danger small" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">رقم الهاتف</label>
                            <InputText class="form-control" @bind-Value="EmployeeToEdit.Phone" />
                            <ValidationMessage For="@(() => EmployeeToEdit.Phone)" class="text-danger small" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">المرتب الأساسي</label>
                            <InputNumber class="form-control" @bind-Value="EmployeeToEdit.BaseSalary" />
                            <ValidationMessage For="@(() => EmployeeToEdit.BaseSalary)" class="text-danger small" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">الوظيفة / النوع</label>
                            <InputSelect class="form-select" @bind-Value="EmployeeToEdit.Type">
                                @foreach (var type in Enum.GetValues<EmployeeType>())
                                {
                                    <option value="@type">@GetEmployeeTypeDisplayName(type)</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-light px-4" @onclick="CloseEditModal">إلغاء</button>
                        <button type="submit" class="btn btn-dark px-4">حفظ التعديلات</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (ShowAddModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);" dir="rtl">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">إضافة موظف جديد لـلمحل</h5>
                </div>

                <EditForm Model="@NewEmployee" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />

                    <div class="modal-body p-4 text-end">
                        <div class="mb-3">
                            <label class="form-label fw-bold">اسم الموظف الفعلي</label>
                            <InputText class="form-control" @bind-Value="NewEmployee.Name" placeholder="اكتب الاسم ثلاثي" />
                            <ValidationMessage For="@(() => NewEmployee.Name)" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">رقم الهاتف (الواتساب)</label>
                            <InputText class="form-control" @bind-Value="NewEmployee.Phone" placeholder="01XXXXXXXXX" />
                            <ValidationMessage For="@(() => NewEmployee.Phone)" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">المرتب الأساسي</label>
                            <InputNumber class="form-control" @bind-Value="NewEmployee.BaseSalary" />
                            <ValidationMessage For="@(() => NewEmployee.BaseSalary)" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">نوع الموظف (الوظيفة)</label>
                            <InputSelect class="form-select" @bind-Value="NewEmployee.Type">
                                <option value="">-- اختر الوظيفة --</option>
                                @foreach (var type in Enum.GetValues<EmployeeType>())
                                {
                                    <option value="@type">@GetEmployeeTypeDisplayName(type)</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => NewEmployee.Type)" class="text-danger small" />
                        </div>
                    </div>

                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-light px-4" @onclick="CloseAddModal">إلغاء</button>
                        <button type="submit" class="btn btn-primary px-4">حفظ البيانات</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<div class="container-fluid p-4" dir="rtl">
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 small rounded-3 mb-3 d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-3"></i>
            <div class="flex-grow-1">&nbsp;&nbsp;@errorMessage</div>
        </div>
    }
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show border-0 mb-4 d-flex align-items-center" role="alert" style="padding-left: 3rem;">
            <i class="bi bi-check-circle-fill me-3 fs-4"></i>
            <div>
                <strong class="ms-1">&nbsp;&nbsp;  تم بنجاح!</strong>
                <span>@successMessage</span>
            </div>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold m-0">إدارة عاملين وموظفي المحل</h4>
            <small class="text-secondary">متابعة بيانات المبيعات، الطيارين، العمال، وحساباتهم</small>
        </div>
        <button @onclick="OpenAddEmployee" class="btn btn-primary shadow-sm px-4">
            <i class="bi bi-person-plus-fill ms-1"></i> إضافة موظف جديد
        </button>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-center">
                    <thead class="table-light">
                        <tr>
                            <th class="py-3">اسم الموظف</th>
                            <th class="py-3">رقم الهاتف</th>
                            <th class="py-3">المرتب الأساسي</th>
                            <th class="py-3">الوظيفة</th>
                            <th class="py-3">الحالة</th>
                            <th class="py-3">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (employees != null && employees.Any())
                        {
                            foreach (var emp in employees)
                            {
                                <tr>
                                    <td class="fw-bold">@emp.Name</td>
                                    <td><span dir="ltr">@emp.Phone</span></td>
                                    <td class="text-success fw-bold">@emp.BaseSalary.ToString("N2") ج.م</td>
                                    <td>
                                        <span class="badge bg-info-subtle text-dark border px-3">
                                            @GetEmployeeTypeDisplayName(emp.Type)
                                        </span>
                                    </td>
                                    <td>
                                        @if (emp.IsActive)
                                        {
                                            <span class="badge bg-success text-white px-3" style="font-size: 0.75rem;">
                                                <i class="bi bi-check-circle-fill ms-1"></i> نشط
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger text-white px-3" style="font-size: 0.75rem;">
                                                <i class="bi bi-x-circle-fill ms-1"></i> معطل
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" dir="ltr">
                                            <button @onclick="() => OpenEditModal(emp)" class="btn btn-sm btn-outline-dark" title="تعديل">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>

                                            @if (emp.IsActive)
                                            {
                                                <button class="btn btn-sm btn-outline-danger px-3" @onclick="() => ToggleStatus(emp)">
                                                    تعطيل <i class="bi bi-person-x-fill ms-1"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-outline-success px-3" @onclick="() => ToggleStatus(emp)">
                                                    تنشيط <i class="bi bi-person-check-fill ms-1"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-muted py-4">لا يوجد موظفين مسجلين حالياً</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private IEnumerable<EmployeeDto> employees = new List<EmployeeDto>();
    private CreateEmployeeDto NewEmployee = new();
    private UpdateEmployeeDto EmployeeToEdit = new();
    private bool ShowAddModal = false;
    private bool ShowEditModal = false;
    private string errorMessage = null!;
    private string successMessage = null!;

    private async Task LoadData()
    {
        employees = await EmployeeService.GetAllEmployeesAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private void CloseAddModal()
    {
        ShowAddModal = false;
        NewEmployee = new CreateEmployeeDto();
    }

    private void CloseEditModal()
    {
        ShowEditModal = false;
        EmployeeToEdit = new UpdateEmployeeDto();
    }

    private async Task ToggleStatus(EmployeeDto emp)
    {
        var result = await EmployeeService.ToggleStatusAsync(emp.Id) ; 

        if (result.IsSuccess)
        {
            emp.IsActive = !emp.IsActive;
            await ShowSuccess(emp.IsActive ? "تم تنشيط الموظف بنجاح." : "تم تعطيل الموظف بنجاح.");
        }
        else
        {
            await ShowError(result.ErrorMessage ?? "حدث خطأ أثناء تحديث حالة الموظف.");
        }
    }

    private async Task HandleValidSubmit()
    {
        var result = await EmployeeService.CreateEmployeeAsync(NewEmployee);
        if (result.IsSuccess)
        {
            CloseAddModal();
            await LoadData();
            await ShowSuccess("تم إضافة الموظف بنجاح.");
        }
        else
        {
            await ShowError(result.ErrorMessage ?? "حدث خطأ أثناء إضافة الموظف.");
        }
    }

    private async Task HandleEditSubmit()
    {
       var result = await EmployeeService.UpdateEmployeeAsync(EmployeeToEdit);
        if (true)
        {
            CloseEditModal();
            await LoadData();
            await ShowSuccess("تم تعديل بيانات الموظف بنجاح.");
        }
        else
        {
           await ShowError(result.ErrorMessage ?? "حدث خطأ أثناء تعديل البيانات.");
        }
    }

    private void OpenAddEmployee()
    {
        NewEmployee = new CreateEmployeeDto();
        ShowAddModal = true;
    }

    private void OpenEditModal(EmployeeDto emp)
    {
        EmployeeToEdit = new UpdateEmployeeDto()
        {
            Id = emp.Id,
            Name = emp.Name,
            Phone = emp.Phone,
            BaseSalary = emp.BaseSalary,
            Type = emp.Type
        };
        ShowEditModal = true;
    }

    private async Task ShowError(string msg)
    {
        errorMessage = msg;
        await Task.Delay(3000);
        errorMessage = null!;
    }

    private async Task ShowSuccess(string msg)
    {
        successMessage = msg;
        await Task.Delay(3000);
        successMessage = null!;
    }

    private string GetEmployeeTypeDisplayName(EmployeeType type)
    {
        return type switch
        {
            EmployeeType.Manager => "مدير المحل",
            EmployeeType.SalesStaff => "موظف مبيعات / صالة",
            EmployeeType.Delivery => "طيار / دليفري",
            EmployeeType.Worker => "عامل / خدمات",
            EmployeeType.Cashier => "كاشير",
            _ => type.ToString()
        };
    }
}